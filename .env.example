# Nexus — environment variables reference
# Copy to .env and fill in your values:  cp .env.example .env

# ── LLM credentials ───────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # optional fallback

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── Postgres (TimescaleDB) ────────────────────────────────────────────────────
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── MLflow ────────────────────────────────────────────────────────────────────
MLFLOW_TRACKING_URI=http://mlflow:5000

# ── LLM selection ─────────────────────────────────────────────────────────────
# gemini (default) | mock. The mock is NEVER chosen automatically when a key is
# missing; a missing key is an error. Use NEXUS_LLM=mock only for offline/CI.
NEXUS_LLM=gemini
DEEPSEEK_API_KEY=                     # optional: independent model family (judge / NexusBench)

# ── Critic configuration ──────────────────────────────────────────────────────
CRITIC_MODEL=gemini-3.5-flash-lite   # pinned; gemini-2.0-flash is retired
CRITIC_MAX_RETRIES=2

# ── Healer configuration ──────────────────────────────────────────────────────
# Auto-apply is OFF by default: the healer evaluates and logs proposals but never applies them.
# true = LEGACY, UNVERIFIED: writes patches to the Config Store without the three-check promotion gate.
NEXUS_HEALER_AUTO_APPLY=false
AUTONOMOUS_MODE=false                 # true = skip the Slack notification step (does not apply patches)
AUTO_APPROVE_DELAY_SECONDS=0          # only used in autonomous_mode
SLACK_WEBHOOK_URL=                    # optional — POST patch proposals to Slack

# ── Classifier configuration ──────────────────────────────────────────────────
PATCHCORE_THRESHOLD=0.45
PATCHCORE_MEMORY_SIZE=500
CALIBRATION_TRACES=50                 # normal traces before classifier activates

# ── Collector ─────────────────────────────────────────────────────────────────
COLLECTOR_PORT=8000
COLLECTOR_KAFKA_TOPIC=nexus.spans.raw

# ── API / Dashboard ───────────────────────────────────────────────────────────
API_PORT=8001
DASHBOARD_PORT=3000
