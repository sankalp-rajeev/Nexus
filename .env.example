# .env.example — all services read from this via docker-compose. Copy to .env.

# LLM credentials
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here  # optional fallback

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Postgres
POSTGRES_USER=nexus
POSTGRES_PASSWORD=nexus_dev_password
POSTGRES_DB=nexus
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# Critic configuration
CRITIC_LLM_PROVIDER=gemini           # gemini | openai
CRITIC_MODEL=gemini-2.0-flash
CRITIC_MAX_RETRIES=2

# Healer configuration
AUTONOMOUS_MODE=false                 # true = auto-apply without human approval
AUTO_APPROVE_DELAY_SECONDS=0         # only used in autonomous_mode
SLACK_WEBHOOK_URL=                   # optional

# Classifier configuration
PATCHCORE_THRESHOLD=0.45
PATCHCORE_MEMORY_SIZE=500
CALIBRATION_TRACES=50                # NORMAL traces before classifier activates

# Collector
COLLECTOR_PORT=8000
COLLECTOR_KAFKA_TOPIC=nexus.spans.raw

# API / Dashboard
API_PORT=8001
DASHBOARD_PORT=3000
