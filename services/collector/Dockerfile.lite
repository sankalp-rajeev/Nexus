FROM python:3.11-slim
WORKDIR /app
COPY sdk /app/sdk
COPY services/collector/requirements-lite.txt /app/requirements-lite.txt
RUN pip install --no-cache-dir /app/sdk -r /app/requirements-lite.txt
COPY services/__init__.py /app/services/__init__.py
COPY services/collector/*.py /app/services/collector/
COPY services/collector/routes/*.py /app/services/collector/routes/
COPY services/detectors /app/services/detectors
COPY services/critic/__init__.py services/critic/fallback.py /app/services/critic/
ENV PYTHONUNBUFFERED=1 NEXUS_QUEUE=inprocess NEXUS_SQLITE_PATH=/data/nexus-lite.db NEXUS_LLM=mock
EXPOSE 8000
# The queue and all consumers must share a single process.
CMD ["uvicorn", "services.collector.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
